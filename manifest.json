{
    "manifest_version": 3,
    "name": "Cadastro Automático de Seguros",
    "version": "1.0",
    "description": "Automatiza o cadastro de usuários em plataformas de seguros de saúde",
    "permissions": [
      "activeTab",
      "scripting",
      "tabs"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "150": "icons/icon.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "150": "icons/icon.png"
    }
  }
  